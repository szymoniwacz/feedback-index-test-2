<main>
  <h1>Feedback received</h1>

  <p>Your submission was saved.</p>

  <dl>
    <dt>Title</dt>
    <dd><%= @feedback.title %></dd>

    <dt>Description</dt>
    <dd><%= simple_format(@feedback.description) %></dd>

    <dt>Category</dt>
    <dd><%= @feedback.category %></dd>
  </dl>

  <%= render "category_form", feedback: @feedback, category_filter: @category_filter %>

  <p><%= link_to "Back to inbox", root_path(category: Feedback.filter_category_param(@category_filter)) %></p>
  <p><%= link_to "Submit more feedback", new_feedback_path %></p>
</main>
